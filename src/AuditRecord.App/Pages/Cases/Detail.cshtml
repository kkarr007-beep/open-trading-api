@page "/cases/{id}"
@model AuditRecord.Pages.Cases.DetailModel
@{
    ViewData["Title"] = "건 상세 · 감사기록";
    var item = Model.Detail;
    var token = Guid.NewGuid().ToString("N");
}
<p class="back"><a href="/cases">목록으로</a></p>
@if (item is null)
{
    <h1>건을 찾을 수 없음</h1>
    <p><a href="/cases">목록으로</a></p>
}
else
{
    <div class="case-hero">
        <div>
            <p class="kicker">@item.Year · @item.Category · 담당 @item.OwnerName</p>
            <h1>@item.Title</h1>
        </div>
        <span class="badge" data-state="@item.DisplayState"><span class="dot" aria-hidden="true"></span>@item.DisplayState</span>
        <a class="btn" href="/cases/@item.CaseId/print">인쇄용</a>
    </div>
    @if (item.DeletionQueued)
    {
        <p class="banner warn"><strong>삭제 대기</strong> 시도 @(item.DeletionAttempts)회@(string.IsNullOrEmpty(item.DeletionError) ? "" : " · " + item.DeletionError)</p>
    }
    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <p class="banner info" role="status">@Model.Flash</p>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="error-summary" role="alert" tabindex="-1"><p>@Model.Error</p></div>
    }
    <ul class="summary" id="retention">
        <li><span>기록 상태</span><strong>@item.DisplayState</strong></li>
        <li><span>조치 진행</span><strong>@item.ActionCount 개 중 @item.DoneActions 개 완료</strong></li>
        <li><span>최초 확정일</span><strong>@(item.FirstConfirmedOn ?? "없음")</strong></li>
        <li><span>현재 확정</span><strong>@(item.ConfirmedOn ?? "확정 아님")</strong></li>
        <li><span>연한·만료</span><strong>@(item.RetentionYears is null ? "연한 없음" : item.RetentionYears + "년") @(item.ExpiryDisplay ?? "")</strong></li>
        <li><span>보류</span><strong>@(item.Hold ? "삭제 보류" : "보류 아님")</strong></li>
        <li><span>삭제 현황</span><strong>@(string.IsNullOrEmpty(item.PurgeNote) ? "삭제 전" : item.PurgeNote)</strong></li>
    </ul>
    <p class="hint">보존 기산일은 최초 결과 확정일이며 취소나 재확정으로 바뀌지 않습니다. 만료 시각은 그 날짜에 보존연한(달력 연)을 더한 날 00:00 KST입니다. 2월 29일이 없는 해는 그달 말로 맞춥니다. 이 계산은 회사의 법정 보존연한이 아닙니다.</p>
    <nav class="section-tabs" aria-label="건 구역">
        <a href="#case">건</a>
        <a href="#result">결과</a>
        <a href="#actions">조치</a>
        <a href="#files">자료</a>
        <a href="#danger-title">확정·연한</a>
    </nav>
    <div class="detail-layout">
        <div class="stack">
            <section id="case" aria-labelledby="case-title">
                <h2 id="case-title">건</h2>
                @if (item.Caps.EditList)
                {
                    <form method="post" data-write="1"  asp-page-handler="SaveCase" data-track>
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@token" />
                        <div class="form-grid">
                            <label class="field">연도<input name="year" type="number" min="1990" max="2100" value="@item.Year" required /></label>
                            <label class="field">구분
                                <select name="category">
                                    <option selected="@(item.Category == "업무진단")">업무진단</option>
                                    <option selected="@(item.Category == "준법감사")">준법감사</option>
                                </select>
                            </label>
                            <label class="field grow">제목<input name="title" maxlength="120" required value="@item.Title" /></label>
                            <label class="field">대상<input name="target" maxlength="120" required value="@item.Target" /></label>
                            <label class="field">담당
                                <select name="ownerId">
                                    @foreach (var user in Model.Users.Where(u => u.Enabled || u.UserId == item.OwnerUserId))
                                    {
                                        <option value="@user.UserId" selected="@(user.UserId == item.OwnerUserId)">@user.DisplayName</option>
                                    }
                                </select>
                            </label>
                            <label class="field">서가<input name="shelf" maxlength="80" value="@item.Shelf" /></label>
                            <label class="field">철번호<input name="binder" maxlength="80" value="@item.BinderNo" /></label>
                        </div>
                        <p class="hint">연한 후에도 남습니다. 개인식별정보·진술·민감한 상세내용을 적지 마세요. 종이 철함은 프로그램이 폐기하지 않습니다.</p>
                        <button type="submit" class="btn btn-primary">저장</button>
                    </form>
                }
                else
                {
                    <dl class="facts">
                        <dt>서가</dt><dd>@(string.IsNullOrEmpty(item.Shelf) ? "없음" : item.Shelf)</dd>
                        <dt>철번호</dt><dd>@(string.IsNullOrEmpty(item.BinderNo) ? "없음" : item.BinderNo)</dd>
                    </dl>
                }
            </section>
            <section id="result" aria-labelledby="result-title">
                <h2 id="result-title">결과</h2>
                <p class="hint">초안 저장은 결과 확정이 아닙니다. 결과 확정은 징계 확정·전자결재가 아닙니다.</p>
                @if (item.Caps.EditResult)
                {
                    <form method="post" data-write="1"  asp-page-handler="SaveResult" data-track>
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        <div class="form-grid">
                            <label class="field">문서번호<input name="documentNo" maxlength="80" value="@item.DocumentNo" readonly /></label>
                            <label class="field grow">결과 한 줄<input name="summary" maxlength="160" value="@item.Summary" /></label>
                            <label class="field grow">결과 본문
                                <textarea name="body" maxlength="20000" rows="6">@item.Body</textarea>
                            </label>
                        </div>
                        <p class="hint">결과 한 줄은 연한 후에도 남습니다. 본문은 만료 후 비워집니다.</p>
                        <button type="submit" class="btn btn-primary">결과 저장</button>
                    </form>
                }
                else
                {
                    <dl class="facts">
                        <dt>문서번호</dt><dd>@(string.IsNullOrEmpty(item.DocumentNo) ? "없음" : item.DocumentNo)</dd>
                        <dt>결과 한 줄</dt><dd>@(string.IsNullOrEmpty(item.Summary) ? "없음" : item.Summary)</dd>
                        <dt>확정자</dt><dd>@(item.ConfirmerName ?? "없음")</dd>
                        <dt>결과 본문</dt>
                        <dd>
                            @if (item.BodiesHidden)
                            { <text>복구 대조 전 — 본문을 표시하지 않습니다.</text> }
                            else if (item.BodiesCleared)
                            { <text>보존 만료로 본문 삭제</text> }
                            else if (string.IsNullOrEmpty(item.Body))
                            { <text>아직 작성된 본문 없음</text> }
                            else
                            { <pre class="body">@item.Body</pre> }
                        </dd>
                    </dl>
                }
            </section>
            <section id="actions" aria-labelledby="actions-title">
                <h2 id="actions-title">조치요구·이행</h2>
                <p class="hint">회신 기록은 피감부서에서 받아 감사파트가 입력합니다. 회신 수신은 이행 완료가 아니고, 이행 확인은 진술 확인서가 아닙니다.</p>
                @if (item.Actions.Count == 0)
                {
                    <p>아직 조치요구가 없습니다.</p>
                }
                @foreach (var action in item.Actions)
                {
                    <details id="action-@action.ActionId" class="action" open>
                        <summary>@action.Sequence. @action.Title · @action.State@(action.Overdue ? " · 회신기한 초과" : "")</summary>
                        <dl class="facts">
                            <dt>유형</dt><dd>@action.Type</dd>
                            <dt>대상 부서</dt><dd>@action.TargetDept</dd>
                            <dt>요구일</dt><dd>@action.RequestedOn</dd>
                            <dt>회신기한</dt><dd>@action.ReplyDueOn</dd>
                            <dt>내용</dt>
                            <dd>
                                @if (item.BodiesHidden) { <text>복구 대조 전 — 내용을 표시하지 않습니다.</text> }
                                else if (action.ContentCleared) { <text>보존 만료로 본문 삭제</text> }
                                else if (string.IsNullOrEmpty(action.Content)) { <text>아직 작성된 본문 없음</text> }
                                else { <pre class="body">@action.Content</pre> }
                            </dd>
                        </dl>
                        @if (action.Entries.Count == 0)
                        {
                            <p>아직 회신 기록 없음</p>
                        }
                        else
                        {
                            <ol class="entries">
                            @foreach (var entry in action.Entries)
                            {
                                <li>
                                    <p>@entry.AtDisplay · @entry.Kind · @entry.FromState → @entry.ToState · @entry.ActorName</p>
                                    @if (item.BodiesHidden)
                                    { <p>복구 대조 전 — 내용을 표시하지 않습니다.</p> }
                                    else if (entry.BodiesCleared && string.IsNullOrEmpty(entry.ReplyBody) && string.IsNullOrEmpty(entry.CheckBody))
                                    { <p>보존 만료로 본문 삭제</p> }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(entry.ReplyBody)) { <p>회신 본문</p><pre class="body">@entry.ReplyBody</pre> }
                                        @if (!string.IsNullOrEmpty(entry.CheckBody)) { <p>확인 본문</p><pre class="body">@entry.CheckBody</pre> }
                                    }
                                </li>
                            }
                            </ol>
                        }
                        @if (item.Caps.Reply && action.State != "이행완료")
                        {
                            <form method="post" data-write="1"  asp-page-handler="Reply">
                                <input type="hidden" name="version" value="@item.Version" />
                                <input type="hidden" name="actionId" value="@action.ActionId" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <label class="field">회신 본문<textarea name="reply" required maxlength="20000" rows="3"></textarea></label>
                                <button type="submit" class="btn">회신 기록</button>
                            </form>
                        }
                        @if (item.Caps.Verify && action.State != "이행완료")
                        {
                            <form method="post" data-write="1"  asp-page-handler="Verify">
                                <input type="hidden" name="version" value="@item.Version" />
                                <input type="hidden" name="actionId" value="@action.ActionId" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <label class="field">이행 확인 본문<textarea name="check" required maxlength="20000" rows="3"></textarea></label>
                                <button type="submit" class="btn">이행 확인</button>
                            </form>
                        }
                    </details>
                }
                @if (item.Caps.AddAction)
                {
                    <h3>조치요구 추가</h3>
                    <form method="post" data-write="1"  asp-page-handler="AddAction" data-track>
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        <div class="form-grid">
                            <label class="field">제목<input name="title" required maxlength="120" /></label>
                            <label class="field">유형
                                <select name="type"><option>지적</option><option>개선요구</option><option>권고</option></select>
                            </label>
                            <label class="field">대상 부서<input name="dept" required maxlength="120" /></label>
                            <label class="field">요구일<input name="requestedOn" type="date" required /></label>
                            <label class="field">회신기한<input name="dueOn" type="date" required /></label>
                            <label class="field grow">내용<textarea name="content" maxlength="20000" rows="3"></textarea></label>
                        </div>
                        <p class="hint">제목과 대상은 연한 후에도 남습니다. 내용은 만료 후 비워집니다.</p>
                        <button type="submit" class="btn">조치요구 추가</button>
                    </form>
                }
            </section>
            <section id="files" aria-labelledby="files-title">
                <h2 id="files-title">자료</h2>
                <p>이 위치의 파일은 사용자 컴퓨터의 나스카로 연다.</p>
                <p class="hint">프로그램은 파일을 열거나 풀지 않습니다. 표시 이름만 남기고, 저장 키는 서버가 만듭니다.</p>
                @if (item.Files.Count == 0)
                {
                    <p>등록된 자료 없음</p>
                }
                else
                {
                    <ul class="file-list">
                    @foreach (var file in item.Files)
                    {
                        var ext = System.IO.Path.GetExtension(file.DisplayName ?? "").ToLowerInvariant();
                        var tile = file.OpenKind == "pdf" || ext == ".pdf" ? "pdf"
                            : file.OpenKind == "image" ? "img"
                            : file.OpenKind == "text" ? "txt"
                            : ext is ".doc" or ".docx" ? "doc"
                            : ext is ".xls" or ".xlsx" ? "xls"
                            : "file";
                        var tileLabel = tile switch { "pdf" => "PDF", "img" => "IMG", "txt" => "TXT", "doc" => "DOC", "xls" => "XLS", _ => "FILE" };
                        var sizeText = file.SizeBytes < 1024 ? file.SizeBytes + " B" : (file.SizeBytes / 1024) + " KB";
                        var meta = file.OpenKind == "none"
                            ? file.Kind + " · " + file.LocationNote
                            : file.Kind + " · " + sizeText + " · " + file.RegisteredBy + " · " + file.RegisteredAtDisplay;
                        var openHref = "/cases/" + item.CaseId + "/files/" + file.AttachmentId + "?view=inline";
                        <li class="file-row">
                            @if (file.OpenKind != "none")
                            {
                                <a class="file-hit" href="@openHref" data-preview="@file.OpenKind" data-title="@file.DisplayName" data-meta="@meta" data-tile="@tileLabel" data-tile-kind="@tile">
                                    <span class="file-ico ico-@tile" aria-hidden="true">@tileLabel</span>
                                    <span class="file-copy">
                                        <span class="file-name" title="@file.DisplayName">@file.DisplayName</span>
                                        <span class="file-meta">@meta</span>
                                    </span>
                                </a>
                            }
                            else
                            {
                                <div class="file-hit">
                                    <span class="file-ico ico-file" aria-hidden="true">FILE</span>
                                    <span class="file-copy">
                                        <span class="file-name" title="@file.DisplayName">@file.DisplayName</span>
                                        <span class="file-meta">@meta</span>
                                    </span>
                                </div>
                            }
                            <div class="file-side">
                                @if (!string.IsNullOrEmpty(file.DisplayLocation))
                                {
                                    <span class="path-clip" title="@file.DisplayLocation">@file.DisplayLocation</span>
                                    <button type="button" class="icon-btn" data-copy="@file.DisplayLocation" aria-label="위치 복사" title="위치 복사">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="10" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M6 16V5.5h9" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                                    </button>
                                }
                                else if (file.State == "Deleted")
                                {
                                    <span class="badge" data-state="자료삭제됨"><span class="dot" aria-hidden="true"></span>삭제됨—복구되지 않음</span>
                                }
                                else
                                {
                                    <span class="file-meta">@file.LocationNote</span>
                                }
                                @if (file.OpenKind is "pdf" or "image" or "text")
                                {
                                    <a class="icon-btn" href="@openHref" data-preview="@file.OpenKind" data-title="@file.DisplayName" data-meta="@meta" data-tile="@tileLabel" data-tile-kind="@tile" aria-label="미리보기" title="미리보기">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                                    </a>
                                }
                                @if (file.OpenKind == "download")
                                {
                                    <a class="icon-btn" href="@(openHref + "&dl=1")" data-preview="download" aria-label="내려받기" title="내려받기">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v10M8 10l4 4 4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </a>
                                }
                                @if (file.OpenKind != "none" && !string.IsNullOrEmpty(file.Sha256))
                                {
                                    <form method="post" data-write="1" asp-page-handler="Hash" class="inline-form">
                                        <input type="hidden" name="version" value="@item.Version" />
                                        <input type="hidden" name="attachmentId" value="@file.AttachmentId" />
                                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                        <button type="submit" class="btn btn-quiet">해시 확인</button>
                                    </form>
                                }
                                @if ((item.Caps.RemoveDraftFile || item.Caps.EarlyDelete) && file.State == "Present")
                                {
                                    <details class="menu">
                                        <summary class="icon-btn" aria-label="삭제 메뉴">···</summary>
                                        <div class="menu-pop">
                                            @if (item.Caps.RemoveDraftFile)
                                            {
                                                <form method="post" data-write="1" asp-page-handler="Remove">
                                                    <input type="hidden" name="version" value="@item.Version" />
                                                    <input type="hidden" name="attachmentId" value="@file.AttachmentId" />
                                                    <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                                    <button type="submit" class="btn">첨부 빼기</button>
                                                </form>
                                            }
                                            @if (item.Caps.EarlyDelete)
                                            {
                                                <form method="post" data-write="1" asp-page-handler="Early">
                                                    <input type="hidden" name="version" value="@item.Version" />
                                                    <input type="hidden" name="attachmentId" value="@file.AttachmentId" />
                                                    <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                                    <label class="field">사유<input name="reason" required maxlength="240" /></label>
                                                    <button type="submit" class="btn btn-danger" id="btn-early-delete-@file.AttachmentId">파일 삭제</button>
                                                </form>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        </li>
                    }
                    </ul>
                }
                @if (item.Caps.AddFile)
                {
                    <form method="post" data-write="1"  asp-page-handler="Upload" enctype="multipart/form-data">
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        <div class="form-grid">
                            <label class="field">종류
                                <select name="kind"><option>결과원문</option><option>증빙</option><option>회신첨부</option></select>
                            </label>
                            <label class="field">표시 이름
                                <input name="displayName" required maxlength="120" placeholder="비워 두면 파일 이름을 그대로 씁니다" />
                                <span class="field-note">확장자가 없으면 올린 파일의 확장자를 붙입니다.</span>
                            </label>
                            <label class="drop">
                                <input type="file" name="upload" required />
                                <span class="drop-copy"><strong>파일을 여기에 놓거나 눌러서 고르기</strong><span>키보드로 이 영역에 들어간 뒤 Enter</span></span>
                                <span class="drop-name" data-file-name>선택된 파일 없음</span>
                            </label>
                        </div>
                        <p class="hint">표시 이름은 연한 후에도 남습니다. 파일 내용으로 쓰지 마세요.</p>
                        <button type="submit" class="btn">자료 추가</button>
                    </form>
                }
            </section>
            <section class="danger-zone" aria-labelledby="danger-title">
                <h2 id="danger-title">확정·종결·연한</h2>
                <p class="hint">@item.PermissionNote 저장 버튼과 떨어져 있습니다. 종결은 자료 삭제가 아닙니다.</p>
                @if (item.Caps.SetRetention)
                {
                    <form method="post" data-write="1"  asp-page-handler="Retention" class="inline-form">
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        <label class="field">보존연한(년)<input name="years" type="number" min="1" max="100" required value="@item.RetentionYears" /></label>
                        @if (item.Caps.RetentionNeedsReason)
                        {
                            <label class="field">사유<input name="reason" required maxlength="240" /></label>
                        }
                        <button type="submit" class="btn">연한 저장</button>
                        <p class="hint">확정 뒤 연한 변경은 사유가 필요하며 이력에 앞뒤 연수와 사유가 남습니다. 이미 지운 자료는 늘려도 돌아오지 않습니다.</p>
                    </form>
                }
                @if (item.Caps.Confirm)
                {
                    <form method="post" data-write="1"  asp-page-handler="Confirm">
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        <p>연한이 있어야 확정됩니다. 기산일은 최초 확정일입니다.</p>
                        <button type="submit" class="btn btn-danger" id="btn-confirm">결과 확정</button>
                    </form>
                }
                @if (item.Caps.Cancel)
                {
                    <form method="post" data-write="1"  asp-page-handler="Cancel">
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        <label class="field">확정 취소 사유<input name="reason" required maxlength="240" /></label>
                        <p class="hint">기존 조치와 이력은 유지됩니다. 이미 지운 파일과 본문은 복구되지 않습니다. 취소해도 담당자의 연한 변경·첨부 빼기 권한은 되살아나지 않습니다.</p>
                        <button type="submit" class="btn btn-danger" id="btn-cancel">확정 취소</button>
                    </form>
                }
                @if (item.Caps.Close)
                {
                    <form method="post" data-write="1"  asp-page-handler="Close">
                        <input type="hidden" name="version" value="@item.Version" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                        @if (item.ActionCount == 0)
                        {
                            <label class="check"><input type="checkbox" name="noActionConfirmed" value="true" /> 조치요구 없음 확인</label>
                        }
                        <p class="hint">미완료 조치가 있으면 종결되지 않습니다. 종결 후에도 파일과 본문은 연한까지 남습니다.</p>
                        <button type="submit" class="btn btn-danger" id="btn-close">종결</button>
                    </form>
                }
            </section>
            @if (Model.CanSeeDiscipline)
            {
                <section id="discipline" aria-labelledby="discipline-title">
                    <h2 id="discipline-title">연결된 징계기록</h2>
                    <p class="hint">이 감사 건의 감사번호로 이어 둔 징계기록입니다. 목록의 성명은 일부를 가립니다. 파트장과 관리자만 봅니다.</p>
                    @if (Model.Discipline.Count == 0)
                    {
                        <p class="empty">연결된 징계기록이 없습니다. <a href="/discipline/new">징계기록 등재</a>에서 이 건의 감사번호를 고르면 여기에 나타납니다.</p>
                    }
                    else
                    {
                        <div class="table-wrap" tabindex="0" aria-label="표 가로 이동">
                            <table class="data">
                                <caption>연결된 징계기록 @(Model.Discipline.Count)건</caption>
                                <thead>
                                    <tr>
                                        <th scope="col" class="num">순번</th>
                                        <th scope="col">사번</th>
                                        <th scope="col">성명</th>
                                        <th scope="col">부서·직위</th>
                                        <th scope="col" class="num">위반일자</th>
                                        <th scope="col">징계종류</th>
                                        <th scope="col" class="num">징계일자</th>
                                        <th scope="col">상태</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var row in Model.Discipline)
                                {
                                    <tr>
                                        <td class="num">@row.Seq</td>
                                        <td>@row.EmployeeNo</td>
                                        <th scope="row"><a href="/discipline/@row.Id">@row.PersonMasked</a></th>
                                        <td>@row.Department @row.Position</td>
                                        <td class="num">@row.ViolationDate</td>
                                        <td>@row.SanctionType</td>
                                        <td class="num">@row.SanctionDate</td>
                                        <td><span class="badge" data-state="@row.Status"><span class="dot" aria-hidden="true"></span>@row.Status</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        </div>
        <aside class="history" aria-label="시간순 이력">
            <h2>시간순 이력</h2>
            <p class="hint">단순 행 변경을 확인하는 해시 체인입니다. 꼬리와 기준값을 함께 바꾸거나 전체를 다시 계산하면 탐지하지 못합니다. 이력은 고치거나 지울 수 없습니다.</p>
            <ol class="timeline">
            @foreach (var row in item.History)
            {
                <li id="h-@row.Seq">
                    <time>@row.AtDisplay</time>
                    <strong>@row.Action</strong>
                    @if (row.ActionSequence is int n)
                    { <span>조치 @n</span> }
                    <span>@row.Summary</span>
                    <span>@row.ActorName</span>
                </li>
            }
            </ol>
            <p><a href="#h-@(item.History.LastOrDefault()?.Seq ?? 0)">마지막으로</a></p>
        </aside>
    </div>
    <dialog id="preview-dialog" aria-labelledby="preview-title">
        <div class="dialog-head">
            <span class="file-ico ico-file" id="preview-ico" aria-hidden="true">FILE</span>
            <div>
                <h2 id="preview-title">파일 미리보기</h2>
                <p class="hint" id="preview-meta"></p>
            </div>
            <a class="btn" id="preview-download">내려받기</a>
            <button type="button" class="icon-btn" data-close aria-label="닫기">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </div>
        <p class="hint preview-note">서버는 파일을 실행하지 않습니다. HTML과 SVG는 미리보기 없이 내려받기만 합니다. 나스카 암호문은 풀지 않습니다.</p>
        <iframe id="preview-frame" title="파일 미리보기" sandbox="" referrerpolicy="no-referrer" hidden></iframe>
        <img id="preview-img" alt="" hidden>
    </dialog>
}
