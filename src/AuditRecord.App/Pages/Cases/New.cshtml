@page "/cases/new"
@model AuditRecord.Pages.Cases.NewModel
@{
    ViewData["Title"] = "건 등록 · 감사기록";
}
<p class="back"><a href="/cases">목록으로</a></p>
<h1>건 등록</h1>
<p class="hint">초안 저장은 결과 확정이 아닙니다. 결과 확정은 징계 확정이나 전자결재가 아닙니다.</p>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error-summary" role="alert" tabindex="-1"><p>@Model.Error</p></div>
}
<form method="post" data-track data-write="1">
    <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
    <div class="form-grid">
        <label class="field">연도
            <input name="year" type="number" min="1990" max="2100" required value="@DateTime.Now.Year" />
        </label>
        <label class="field">구분
            <select name="category" required>
                <option>업무진단</option>
                <option>준법감사</option>
            </select>
        </label>
        <label class="field grow">제목
            <input name="title" required maxlength="120" />
        </label>
        <label class="field">대상
            <input name="target" required maxlength="120" />
        </label>
        <label class="field">담당
            <select name="ownerId" required>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.UserId">@user.DisplayName</option>
                }
            </select>
        </label>
        <label class="field">서가
            <input name="shelf" maxlength="80" />
        </label>
        <label class="field">철번호
            <input name="binder" maxlength="80" />
        </label>
        <label class="field">문서번호
            <input id="doc-preview" value="자동 부여(예정: @Model.PreviewNo)" readonly />
        </label>
        <label class="field">보존연한(년)
            <input name="retentionYears" type="number" min="1" max="100" />
        </label>
        <label class="field grow">결과 한 줄
            <input name="summary" maxlength="160" />
        </label>
        <label class="field grow">결과 본문
            <textarea name="body" maxlength="20000" rows="6"></textarea>
        </label>
    </div>
    <p class="hint">연한 후에도 남습니다. 제목, 대상, 결과 한 줄, 서가, 철번호에는 개인식별정보·진술·민감한 상세내용을 적지 마세요. 결과 본문은 만료 후 비워집니다.</p>
    <button type="submit" class="btn btn-primary">초안 저장</button>
</form>
