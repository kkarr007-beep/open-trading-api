@page "/admin"
@model AuditRecord.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "관리 · 감사기록";
}
@if (Model.Forbidden)
{
    <h1>이 화면은 관리자만 엽니다</h1>
    <p>담당과 파트장은 관리 화면을 열 수 없습니다. 할 일과 건 목록은 그대로 사용할 수 있습니다.</p>
    <p><a href="/todo">할 일로 돌아가기</a></p>
}
else
{
<div class="page-head">
    <h1>관리</h1>
    <p class="hint">계정, 내부 백업, 삭제 보류만 다룹니다. 복구 버튼은 없습니다.</p>
</div>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error-summary" role="alert" tabindex="-1"><p>@Model.Error</p></div>
}
@if (!string.IsNullOrEmpty(Model.Flash))
{
    <p class="banner info" role="status">@Model.Flash</p>
}
@if (!string.IsNullOrEmpty(Model.Issued))
{
    <div class="banner warn" role="status">
        <p>임시 비밀번호는 이 화면에만 표시됩니다. 전달 후 이 페이지를 떠나면 다시 볼 수 없습니다.</p>
        <p class="secret">@Model.Issued</p>
    </div>
}
<section aria-labelledby="policy-title">
    <h2 id="policy-title">보존·백업 기준</h2>
    <p>만료 시 결과 본문, 조치 내용, 회신·확인 본문, 파일과 저장 위치를 지웁니다. 목록, 결과 한 줄, 조치 제목·유형·대상·날짜·상태, 자료 이름과 삭제일, 이력은 남습니다. SQLite secure_delete, 체크포인트, VACUUM은 논리 잔여를 줄일 뿐 SSD, 섀도 복사, 예전 백업의 물리적 완전 삭제를 증명하지 않습니다.</p>
    <p>백업 정리 기본값은 이 프로그램이 만든 완료 백업만 최대 7일과 최대 7세대로 두는 선택입니다. 회사나 법령의 보존기간이 아니며, 다른 폴더의 파일은 지우지 않습니다.</p>
    @if (Model.State.PolicyAcknowledged)
    {
        <p>확인됨 @Model.State.PolicyAcknowledgedAt · @(Model.State.PolicyAcknowledgedBy ?? "")</p>
    }
    else
    {
        <form method="post" data-write="1"  asp-page-handler="Ack">
            <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
            <label class="check"><input type="checkbox" name="accepted" value="true" /> 위 기준을 이해했고, 운영 데이터에 대해 자동 보존 삭제를 켭니다.</label>
            <button type="submit" class="btn btn-primary">정책 확인</button>
        </form>
    }
    <form method="post" data-write="1"  asp-page-handler="Limits" class="inline-form">
        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
        <label class="field">백업 보관 일수<input name="days" type="number" min="1" max="3650" value="@Model.State.BackupDays" required /></label>
        <label class="field">완료 세대 수<input name="generations" type="number" min="1" max="100" value="@Model.State.BackupGenerations" required /></label>
        <button type="submit" class="btn">정리 기준 저장</button>
    </form>
    <form method="post" data-write="1" asp-page-handler="RunDue" class="inline-form">
        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
        <button type="submit" class="btn">만료 삭제 지금 실행</button>
    </form>
    <p class="hint">연한이 이미 지난 건만, 삭제 보류가 아닌 것만 지웁니다. 기한을 앞당기지 않습니다.</p>
</section>
<section aria-labelledby="users-title">
    <h2 id="users-title">계정</h2>
    <form method="post" data-write="1"  asp-page-handler="Create" class="form-grid">
        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
        <label class="field">표시 이름<input name="displayName" required maxlength="40" /></label>
        <label class="field">로그인 이름<input name="login" required maxlength="40" autocomplete="off" spellcheck="false" /></label>
        <label class="field" for="new-account-role">역할
            <select id="new-account-role" name="role" aria-label="새 계정의 역할"><option>담당</option><option>파트장</option><option>관리자</option></select>
        </label>
        <button type="submit" class="btn btn-primary">계정 만들기</button>
    </form>
    <p class="hint">표시 이름에 실명을 넣지 마세요. 끄기, 초기화, 역할 변경은 그 계정의 기존 세션을 끊습니다. 마지막 활성 관리자는 끄거나 내릴 수 없습니다.</p>
    <div class="table-wrap" tabindex="0" aria-label="표 가로 이동">
        <table class="data">
            <caption>계정 @(Model.Users.Count)명</caption>
            <thead>
                <tr><th scope="col">표시 이름</th><th scope="col">로그인</th><th scope="col">역할</th><th scope="col">상태</th><th scope="col">작업</th></tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <th scope="row">@user.DisplayName</th>
                    <td>@user.Login</td>
                    <td>@user.Role@(user.IsLastAdmin ? " · 마지막 관리자" : "")</td>
                    <td><span class="badge" data-state="@(user.Enabled ? "활성" : "끔")"><span class="dot" aria-hidden="true"></span>@(user.Enabled ? "활성" : "끔")</span>@(user.MustChange ? " · 비밀번호 변경 필요" : "")</td>
                    <td class="account-actions">
                        <fieldset class="role-box">
                            <legend>역할</legend>
                            <form method="post" data-write="1"  asp-page-handler="Role" class="inline-form">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <label class="field" for="role-@user.UserId">@user.DisplayName 역할
                                    <select id="role-@user.UserId" name="role" aria-label="@user.DisplayName 역할">
                                        <option selected="@(user.Role == "담당")">담당</option>
                                        <option selected="@(user.Role == "파트장")">파트장</option>
                                        <option selected="@(user.Role == "관리자")">관리자</option>
                                    </select>
                                </label>
                                <button type="submit" class="btn">역할 저장</button>
                            </form>
                        </fieldset>
                        <fieldset class="stop-box">
                            <legend>계정 중단</legend>
                            @if (user.IsLastAdmin)
                            {
                                <p class="hint">마지막 활성 관리자는 끌 수 없습니다.</p>
                            }
                            else if (user.Enabled)
                            {
                                <button type="button" class="btn" data-dialog="disable-@user.UserId">계정 끄기</button>
                            }
                            <button type="button" class="btn" data-dialog="reset-@user.UserId">비밀번호 초기화</button>
                        </fieldset>
                        @if (user.Enabled && !user.IsLastAdmin)
                        {
                            <dialog id="disable-@user.UserId" aria-labelledby="disable-title-@user.UserId">
                                <form method="post" data-write="1"  asp-page-handler="Disable">
                                    <h2 id="disable-title-@user.UserId">계정 끄기</h2>
                                    <p>@user.DisplayName (@user.Login) 계정을 끕니다. 기존 세션은 바로 끝납니다.</p>
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                    <div class="row-actions">
                                        <button type="button" class="btn" data-close autofocus>취소</button>
                                        <button type="submit" class="btn">계정 끄기</button>
                                    </div>
                                </form>
                            </dialog>
                        }
                        <dialog id="reset-@user.UserId" aria-labelledby="reset-title-@user.UserId">
                            <form method="post" data-write="1"  asp-page-handler="Reset">
                                <h2 id="reset-title-@user.UserId">비밀번호 초기화</h2>
                                <p>@user.DisplayName (@user.Login) 의 비밀번호를 초기화합니다. 기존 세션은 바로 끝나고, 임시 비밀번호는 이 화면에 한 번만 표시됩니다.</p>
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <div class="row-actions">
                                    <button type="button" class="btn" data-close autofocus>취소</button>
                                    <button type="submit" class="btn">비밀번호 초기화</button>
                                </div>
                            </form>
                        </dialog>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
<section aria-labelledby="backup-title">
    <h2 id="backup-title">내부 백업</h2>
    <p>허용된 내부 디스크 안에서만 복사합니다. 현재 허용 위치: <span class="path">@Model.BackupRoot</span></p>
    <p class="hint">SQLite Backup API로 데이터베이스를 맞춘 뒤, 그 스냅샷이 가리키는 파일만 바이트 단위로 복사합니다. 내용을 읽지 않습니다. 백업이 암호화되어 있어도 연한 삭제가 해결되지는 않습니다. 같은 디스크의 백업은 서버 장애를 대신하지 않습니다. 인터넷 백업은 없습니다.</p>
    <form method="post" data-write="1"  asp-page-handler="Backup" class="inline-form">
        <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
        <label class="field">하위 폴더 이름<input name="subfolder" maxlength="40" /></label>
        <button type="submit" class="btn btn-primary">백업 시작</button>
    </form>
    <p class="hint">백업 중에는 변경과 삭제가 잠시 기다립니다. 실패한 복사본은 완료로 표시하지 않습니다.</p>
    @if (Model.Backups.Count == 0)
    {
        <p>아직 백업 기록이 없습니다.</p>
    }
    else
    {
        <div class="table-wrap" tabindex="0" aria-label="최근 백업 표 가로 이동">
        <table class="data">
            <caption>최근 백업</caption>
            <thead><tr><th scope="col">시각</th><th scope="col">상태</th><th scope="col">식별자</th><th scope="col">행위자</th><th scope="col">검사</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Backups)
            {
                <tr>
                    <td class="num">@row.AtDisplay</td>
                    <td>@(row.State == "Complete" ? "완료" : "미완료")</td>
                    <td>@(row.BackupId ?? row.ErrorCode)</td>
                    <td>@row.ActorName</td>
                    <td>
                        @if (row.State == "Complete" && row.BackupId is not null)
                        {
                            <form method="post" data-write="1"  asp-page-handler="Verify">
                                <input type="hidden" name="backupId" value="@row.BackupId" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <button type="submit" class="btn">무결성 검사</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
    <h3>복구</h3>
    <p>한 번에 덮어쓰는 복구는 제공하지 않습니다. 오래된 백업을 되돌리면 그 사이에 지운 본문과 파일이 데이터베이스 안에 다시 들어옵니다. 서비스 계정이 아닌 절차로 멈추고, 현재 <span class="path">data/retention-ledger.log</span>는 바꾸지 않은 채 데이터베이스와 파일만 되돌리세요. 백업 폴더의 ledger-copy.log로 현재 원장을 덮어쓰지 마세요.</p>
    <p>다시 켜면 원장과 데이터베이스를 비교합니다. 지운 본문이나 파일이 되살아나 있으면, 잠금 파일이 없어도 읽기 전용으로 잠급니다. 본문과 자료 위치는 숨기고, 삭제는 자동으로 다시 적용하지 않습니다. 관리자가 아래 버튼으로 다시 적용할 때만 이력에 남고 잠금이 풀립니다. 원장이 없으면 읽기 전용을 유지합니다.</p>
    @if (Model.State.RestoreLocked)
    {
        <form method="post" data-write="reapply" asp-page-handler="Reapply">
            <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
            <button type="submit" class="btn">삭제 기록 다시 적용</button>
        </form>
    }
</section>
<section aria-labelledby="jobs-title">
    <h2 id="jobs-title">삭제 작업</h2>
    <p class="hint">같은 대상의 끝나지 않은 작업은 하나만 둡니다. 파일이 이미 없으면 그 작업은 완료로 닫습니다.</p>
    @if (Model.Jobs.Count == 0)
    {
        <p>삭제 작업이 없습니다.</p>
    }
    else
    {
        <div class="table-wrap" tabindex="0" aria-label="삭제 작업 표 가로 이동">
        <table class="data">
            <caption>최근 삭제 작업</caption>
            <thead><tr><th scope="col">시각</th><th scope="col">건</th><th scope="col">종류</th><th scope="col">상태</th><th scope="col">오류</th></tr></thead>
            <tbody>
            @foreach (var job in Model.Jobs)
            {
                <tr>
                    <td class="num">@job.AtDisplay</td>
                    <th scope="row"><a href="/cases/@job.CaseId">@job.Title</a></th>
                    <td>@(job.Kind == "Expiry" ? "연한 삭제" : job.Kind == "EarlyFile" ? "연한 전 파일 삭제" : "첨부 빼기")</td>
                    <td>@(job.Status switch { "Pending" => "대기", "Running" => "진행", "RetryWait" => "다시 시도", "Paused" => "멈춤", "Complete" => "완료", _ => job.Status })</td>
                    <td>@(job.ErrorCode ?? "")</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</section>
<section aria-labelledby="hold-title">
    <h2 id="hold-title">삭제 보류</h2>
    <form method="post" asp-page-handler="Find" class="inline-form">
        <label class="field">제목·대상·문서번호·철번호<input name="text" autocomplete="off" spellcheck="false" /></label>
        <button type="submit" class="btn">찾기</button>
    </form>
    <div class="table-wrap" tabindex="0" aria-label="표 가로 이동">
        <table class="data">
            <caption>보류 대상</caption>
            <thead><tr><th scope="col">제목</th><th scope="col">상태</th><th scope="col">만료</th><th scope="col">보류</th><th scope="col">작업</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Cases.Items)
            {
                <tr>
                    <th scope="row"><a href="/cases/@row.CaseId">@row.Title</a></th>
                    <td>@row.DisplayState</td>
                    <td class="num">@(row.ExpiryDate ?? "없음")</td>
                    <td>@(row.Hold ? "삭제 보류" : "보류 아님")</td>
                    <td>
                        @if (!row.Hold)
                        {
                            <form method="post" data-write="1"  asp-page-handler="Hold">
                                <input type="hidden" name="caseId" value="@row.CaseId" />
                                <input type="hidden" name="version" value="@row.Version" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <label class="field">사유<input name="reason" required maxlength="240" /></label>
                                <button type="submit" class="btn">보류 설정</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" data-write="1"  asp-page-handler="Unhold">
                                <input type="hidden" name="caseId" value="@row.CaseId" />
                                <input type="hidden" name="version" value="@row.Version" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" />
                                <label class="field">해제 사유<input name="reason" required maxlength="240" /></label>
                                <p class="hint">유예기간은 없습니다. 이미 만료면 다음 삭제 처리 대상입니다. 이미 지운 자료는 복구되지 않습니다.</p>
                                <button type="submit" class="btn btn-danger">보류 해제</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
<section aria-labelledby="maint-title">
    <h2 id="maint-title">저장소 정비</h2>
    <p>여유 공간이 데이터베이스의 약 두 배는 있어야 VACUUM을 권합니다. 정비 중에는 변경이 기다립니다.</p>
    <form method="post" data-write="1"  asp-page-handler="Vacuum">
        <button type="submit" class="btn">체크포인트와 VACUUM</button>
    </form>
</section>
}
