@page "/discipline"
@model AuditRecord.Pages.Discipline.IndexModel
@{
    ViewData["Title"] = "징계기록 · 감사기록";
}
@if (!Model.Allowed)
{
    <h1>징계기록은 파트장과 관리자만 봅니다</h1>
    <p>처분 대상의 이름과 경위는 담당 화면과 나누었습니다. 할 일과 건 목록은 그대로 사용할 수 있습니다.</p>
    <p><a href="/todo">할 일로 돌아가기</a></p>
}
else
{
<div class="page-head">
    <div>
        <h1>징계기록</h1>
        <p class="hint">감사 건과 따로 둡니다. 목록의 이름은 일부를 가리고, 상세를 열면 열람 이력이 남습니다.</p>
    </div>
    <div class="row-actions">
        @if (Model.Admin)
        {
            <form method="post" asp-page-handler="Export"><input type="hidden" name="requestId" value="@Guid.NewGuid().ToString("N")" /><button class="btn" type="submit">CSV</button></form>
        }
        <a class="btn btn-primary" href="/discipline/new">기록 등록</a>
    </div>
</div>
<form method="get" class="toolbar">
    <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span class="sr">이름, 내용, 장소, 건 제목</span>
        <input name="text" value="@Model.Text" placeholder="이름, 내용, 장소, 건 제목" maxlength="80" />
    </label>
    <label class="field">처분
        <select name="sanction" aria-label="처분">
            <option value="">전체</option>
            @foreach (var name in new[] { "견책", "감봉", "정직", "경고" })
            {
                <option selected="@(Model.Sanction == name)">@name</option>
            }
        </select>
    </label>
    <button class="btn btn-primary" type="submit">찾기</button>
</form>
@if (Model.Rows.Count == 0)
{
    <p class="empty">조건에 맞는 징계기록이 없습니다.</p>
}
else
{
    <div class="table-wrap wide-table" tabindex="0" aria-label="표 가로 이동">
        <table class="data">
            <caption>징계기록 @Model.Rows.Count 건</caption>
            <thead>
                <tr>
                    <th scope="col">누가</th>
                    <th scope="col">언제</th>
                    <th scope="col">어디서</th>
                    <th scope="col">무엇을</th>
                    <th scope="col">어떻게</th>
                    <th scope="col">왜</th>
                    <th scope="col">처분</th>
                    <th scope="col">결과</th>
                    <th scope="col">상태</th>
                    <th scope="col">감사 건</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <th scope="row"><a href="/discipline/@row.Id">@row.WhoMasked</a></th>
                    <td class="num">@row.WhenText</td>
                    <td>@row.WhereText</td>
                    <td>@row.WhatText</td>
                    <td>@row.HowText</td>
                    <td>@row.WhyText</td>
                    <td><span class="badge" data-state="조치중"><span class="dot" aria-hidden="true"></span>@row.Sanction</span></td>
                    <td>@row.Outcome</td>
                    <td><span class="badge" data-state="@row.Status"><span class="dot" aria-hidden="true"></span>@row.Status</span></td>
                    <td>@if (row.CaseId != null) { <a href="/cases/@row.CaseId">@row.CaseTitle</a> } else { <text>없음</text> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <ul class="card-list">
    @foreach (var row in Model.Rows)
    {
        <li>
            <a href="/discipline/@row.Id"><strong>@row.WhoMasked</strong> · @row.Sanction</a>
            <p>@row.WhenText · @row.WhereText</p>
            <p>@row.WhatText</p>
        </li>
    }
    </ul>
}
}
