@page "/account/password"
@model AuditRecord.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "비밀번호 · 감사기록";
}
<section class="narrow">
    <h1>비밀번호 변경</h1>
    @if (Model.MustChange)
    {
        <p class="banner warn">임시 비밀번호로 들어온 상태입니다. 다른 화면으로 가기 전에 비밀번호를 바꾸세요.</p>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="error-summary" role="alert" tabindex="-1"><p>@Model.Error</p></div>
    }
    <form method="post">
        <label class="field">현재 비밀번호
            <input name="currentPassword" type="password" autocomplete="current-password" required />
        </label>
        <label class="field">새 비밀번호
            <input name="newPassword" type="password" autocomplete="new-password" required minlength="12" />
        </label>
        <p class="hint">12자 이상. 로그인 이름과 같게 두지 마세요.</p>
        <button type="submit" class="btn btn-primary">변경하고 다시 로그인</button>
    </form>
</section>
