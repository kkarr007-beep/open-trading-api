@page "/account/setup"
@model AuditRecord.Pages.Account.SetupModel
@{
    ViewData["Title"] = "간편 설치 · 감사기록";
}
<section class="auth">
    <div class="auth-mark" aria-hidden="true">감</div>
    <h1>간편 설치</h1>
    @if (Model.Blocked)
    {
        <div class="error-summary" role="alert" tabindex="-1">
            <p>설치는 이 서버 컴퓨터의 <span class="path">http://127.0.0.1:47321</span> 에서만 합니다. 내부망 주소로는 열 수 없습니다.</p>
        </div>
    }
    else
    {
        <p class="auth-lead">비밀번호 하나만 정하면 끝납니다. 다른 컴퓨터는 브라우저로 들어와 그 비밀번호만 누릅니다.</p>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error-summary" role="alert" tabindex="-1"><p>@Model.Error</p></div>
        }
        <form method="post" class="auth-form">
            <label class="field">우리 파트 이름
                <input name="teamName" maxlength="40" autocomplete="off" value="감사파트" />
                <span class="field-note">화면 위와 기록에 남는 이름입니다. 실명은 적지 마세요.</span>
            </label>
            <label class="field">접속 비밀번호
                <input name="password" type="password" required minlength="12" autocomplete="new-password" />
                <span class="field-note">12자 이상. 이 비밀번호를 파트원에게 알려 주면 됩니다.</span>
            </label>
            <label class="field">비밀번호 확인
                <input name="confirm" type="password" required minlength="12" autocomplete="new-password" />
            </label>
            <button type="submit" class="btn btn-primary btn-lg btn-block">설치하고 시작하기</button>
        </form>
        <ol class="auth-steps">
            <li>이 화면에서 비밀번호를 정합니다.</li>
            <li>서버의 내부망 주소를 파트원에게 알려 줍니다.</li>
            <li>파트원은 그 주소를 열고 비밀번호만 누르면 들어옵니다.</li>
        </ol>
    }
</section>
